# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_NAME="Parent-Teacher Communication and Student Monitoring System"
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Account lockout ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# --- Email (SMTP) - prepared for verification/reset emails ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME="School System"
SMTP_SENDER_EMAIL=
